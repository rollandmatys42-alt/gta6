{
  "name": "MarketplaceListing",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string",
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "category": {
      "type": "string",
      "enum": [
        "Video pack",
        "Editing preset",
        "Template",
        "Creator bundle",
        "Other"
      ]
    },
    "price_cents": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "GBP"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "published",
        "rejected",
        "archived"
      ],
      "default": "draft"
    },
    "license_terms": {
      "type": "string",
      "maxLength": 2000
    },
    "preview_url": {
      "type": "string",
      "format": "uri"
    },
    "asset_reference": {
      "type": "string",
      "maxLength": 300
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "seller_id",
    "seller_name",
    "title",
    "description",
    "category",
    "price_cents",
    "currency",
    "status",
    "created_by"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "$or": [
            {
              "data.seller_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}