{
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "description": "Base44 access role"
    },
    "display_name": {
      "type": "string",
      "maxLength": 80,
      "description": "Public creator display name"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "viewer",
        "creator"
      ],
      "default": "viewer",
      "description": "Creator profile type",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "pro",
        "premium"
      ],
      "default": "free",
      "description": "Server-managed subscription tier",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "inactive",
        "active",
        "past_due",
        "cancelled",
        "trialing"
      ],
      "default": "inactive",
      "description": "Server-managed billing status",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "subscription_currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "GBP"
      ],
      "default": "USD",
      "description": "Billing currency",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "subscription_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Current uninterrupted subscription start",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "subscription_streak_months": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Completed uninterrupted paid months",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "subscription_cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Voluntary cancellation timestamp",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "role"
  ]
}