{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 140
    },
    "description": {
      "type": "string",
      "maxLength": 3000
    },
    "category": {
      "type": "string",
      "enum": ["Cinematics", "Gameplay", "Characters", "Vehicles", "Locations", "Missions", "Shorts", "Edit packs", "Tutorials", "Other"]
    },
    "language": { "type": "string", "enum": ["en", "fr", "es", "pt", "it", "de"], "default": "en" },
    "is_featured": { "type": "boolean", "default": false },
    "is_free_sample": { "type": "boolean", "default": false },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "thumbnail_url": {
      "type": "string",
      "format": "uri"
    },
    "creator_name": {
      "type": "string",
      "maxLength": 80
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "license_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "restricted"
      ],
      "default": "pending"
    },
    "source_reference": {
      "type": "string",
      "format": "uri"
    },
    "storage_key": {
      "type": "string",
      "description": "Private R2 object key for clean master",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "watermarked_storage_key": {
      "type": "string",
      "description": "Private R2 object key for server-prepared watermarked rendition",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "uploaded_by": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "category",
    "status",
    "license_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}