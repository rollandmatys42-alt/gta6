{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "TikTok",
        "Instagram",
        "YouTube",
        "X",
        "Facebook",
        "LinkedIn"
      ]
    },
    "caption": {
      "type": "string",
      "maxLength": 5000
    },
    "media_reference": {
      "type": "string",
      "maxLength": 500
    },
    "account_id": { "type": "string", "maxLength": 200 },
    "media_type": { "type": "string", "enum": ["none", "video"], "default": "none" },
    "published_at": { "type": "string", "format": "date-time" },
    "last_attempt_at": { "type": "string", "format": "date-time" },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "publishing",
        "published",
        "failed"
      ],
      "default": "draft"
    },
    "external_post_id": {
      "type": "string",
      "maxLength": 200
    },
    "error_message": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "user_id",
    "platform",
    "caption",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": false,
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}