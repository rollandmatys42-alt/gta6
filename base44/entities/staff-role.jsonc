{
  "name": "StaffRole",
  "type": "object",
  "properties": {
    "staff_user_id": {
      "type": "string"
    },
    "staff_email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "moderator",
        "support",
        "content_manager",
        "marketplace_manager"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "staff_user_id",
    "staff_email",
    "role",
    "permissions",
    "active"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}