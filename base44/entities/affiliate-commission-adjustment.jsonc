{
  "name": "AffiliateCommissionAdjustment",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "referral_credit_id": { "type": "string" },
    "stripe_invoice_id": { "type": "string" },
    "stripe_event_id": { "type": "string" },
    "currency": { "type": "string", "enum": ["GBP", "EUR", "USD"] },
    "amount_cents": { "type": "integer", "minimum": 1 },
    "reason": { "type": "string", "maxLength": 1000 },
    "status": { "type": "string", "enum": ["open", "offset", "collected"], "default": "open" },
    "admin_note": { "type": "string", "maxLength": 1000 }
  },
  "required": ["user_id", "referral_credit_id", "stripe_event_id", "currency", "amount_cents", "reason", "status"],
  "rls": {
    "read": { "$or": [{ "data.user_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": false,
    "update": { "user_condition": { "role": "admin" } },
    "delete": false
  }
}