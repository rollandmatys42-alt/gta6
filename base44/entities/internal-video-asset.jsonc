{
  "name": "InternalVideoAsset",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 180
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "source"
      ],
      "default": "source"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "archived"
      ],
      "default": "ready"
    },
    "category": {
      "type": "string",
      "maxLength": 80
    },
    "language": {
      "type": "string",
      "maxLength": 12,
      "default": "en"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 50
      }
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1000
    },
    "source_platform": {
      "type": "string",
      "maxLength": 80
    },
    "rights_attested_by": {
      "type": "string",
      "maxLength": 128
    },
    "rights_attested_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_countries": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2
      }
    },
    "topic": {
      "type": "string",
      "maxLength": 300
    },
    "viral_potential_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_favourite": {
      "type": "boolean",
      "default": false
    },
    "viral_score_factors": {
      "type": "object"
    },
    "performance_viral_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "thumbnail_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1000
    },
    "review_status": {
      "type": "string",
      "enum": [
        "needs_review",
        "approved",
        "rejected"
      ],
      "default": "needs_review"
    },
    "rights_status": {
      "type": "string",
      "enum": [
        "pending",
        "authorised",
        "restricted",
        "not_applicable"
      ],
      "default": "pending"
    },
    "rights_evidence_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1000
    },
    "storage_provider": {
      "type": "string",
      "enum": [
        "s3",
        "google_drive",
        "external_source",
        "mega",
        "onedrive",
        "dropbox",
        "direct_url"
      ],
      "default": "s3"
    },
    "storage_source_id": {
      "type": "string",
      "maxLength": 128
    },
    "storage_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1500
    },
    "preview_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1500
    },
    "download_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1500
    },
    "storage_key": {
      "type": "string",
      "maxLength": 600
    },
    "storage_connection_id": {
      "type": "string",
      "maxLength": 128
    },
    "google_drive_file_id": {
      "type": "string",
      "maxLength": 512
    },
    "preview_drive_file_id": {
      "type": "string",
      "maxLength": 512
    },
    "google_drive_parent_id": {
      "type": "string",
      "maxLength": 512
    },
    "google_drive_web_view_link": {
      "type": "string",
      "format": "uri",
      "maxLength": 1000
    },
    "original_filename": {
      "type": "string",
      "maxLength": 180
    },
    "mime_type": {
      "type": "string",
      "maxLength": 100
    },
    "file_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "width": {
      "type": "integer",
      "minimum": 0
    },
    "height": {
      "type": "integer",
      "minimum": 0
    },
    "public_video_id": {
      "type": "string",
      "maxLength": 128
    },
    "public_video_status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "public_published_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    },
    "created_by": {
      "type": "string",
      "maxLength": 128
    }
  },
  "required": [
    "title",
    "asset_type",
    "status",
    "rights_status",
    "created_by"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
