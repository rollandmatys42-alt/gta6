{
  "name": "InternalVideoAsset",
  "type": "object",
  "properties": {
    "title": { "type": "string", "minLength": 2, "maxLength": 180 },
    "description": { "type": "string", "maxLength": 5000 },
    "asset_type": { "type": "string", "enum": ["source", "clip", "derivative"], "default": "source" },
    "status": { "type": "string", "enum": ["stored", "processing", "ready", "archived"], "default": "stored" },
    "category": { "type": "string", "maxLength": 80 },
    "language": { "type": "string", "maxLength": 12, "default": "en" },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 50 } },
    "source_url": { "type": "string", "format": "uri", "maxLength": 1000 },
    "rights_status": { "type": "string", "enum": ["pending", "authorised", "restricted", "not_applicable"], "default": "pending" },
    "rights_evidence_url": { "type": "string", "format": "uri", "maxLength": 1000 },
    "storage_key": { "type": "string", "maxLength": 600 },
    "storage_connection_id": { "type": "string", "maxLength": 128 },
    "original_filename": { "type": "string", "maxLength": 180 },
    "mime_type": { "type": "string", "maxLength": 100 },
    "file_size_bytes": { "type": "integer", "minimum": 0 },
    "duration_seconds": { "type": "integer", "minimum": 0 },
    "width": { "type": "integer", "minimum": 0 },
    "height": { "type": "integer", "minimum": 0 },
    "parent_asset_id": { "type": "string", "maxLength": 128 },
    "transcript": { "type": "string", "maxLength": 200000 },
    "notes": { "type": "string", "maxLength": 5000 },
    "created_by": { "type": "string", "maxLength": 128 }
  },
  "required": ["title", "asset_type", "status", "rights_status", "storage_key", "storage_connection_id", "created_by"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}