{
  "name": "NewsSource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "feed_url": {
      "type": "string",
      "format": "uri"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "official",
        "media",
        "community",
        "social"
      ]
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_status": {
      "type": "string",
      "maxLength": 200
    },
    "last_external_id": { "type": "string", "maxLength": 100 },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "feed_url",
    "source_type",
    "enabled"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}