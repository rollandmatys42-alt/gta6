{
  "name": "SocialAccount",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "provider": { "type": "string", "enum": ["TikTok", "Instagram", "Facebook", "YouTube", "X"] },
    "provider_account_id": { "type": "string", "maxLength": 200 },
    "account_name": { "type": "string", "maxLength": 160 },
    "account_type": { "type": "string", "enum": ["profile", "page", "channel", "business"], "default": "profile" },
    "encrypted_access_token": { "type": "string", "maxLength": 8000 },
    "encrypted_refresh_token": { "type": "string", "maxLength": 8000 },
    "token_expires_at": { "type": "string", "format": "date-time" },
    "refresh_expires_at": { "type": "string", "format": "date-time" },
    "scopes": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["connected", "expired", "error", "disconnected"], "default": "connected" },
    "metadata_json": { "type": "string", "maxLength": 5000 },
    "connected_at": { "type": "string", "format": "date-time" },
    "last_used_at": { "type": "string", "format": "date-time" },
    "last_error": { "type": "string", "maxLength": 1000 }
  },
  "required": ["user_id", "provider", "provider_account_id", "account_name", "account_type", "encrypted_access_token", "status"],
  "rls": {
    "read": { "$or": [{ "data.user_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": false,
    "update": false,
    "delete": false
  }
}