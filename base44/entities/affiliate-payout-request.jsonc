{
  "name": "AffiliatePayoutRequest",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "amount_cents": { "type": "integer", "minimum": 1 },
    "currency": { "type": "string", "enum": ["GBP", "EUR", "USD"] },
    "status": { "type": "string", "enum": ["requested", "processing", "sent", "rejected", "failed"], "default": "requested" },
    "connected_account_id": { "type": "string" },
    "allocations": { "type": "array", "items": { "type": "object", "properties": { "credit_id": { "type": "string" }, "amount_cents": { "type": "integer" } }, "required": ["credit_id", "amount_cents"] } },
    "stripe_transfer_id": { "type": "string" },
    "admin_note": { "type": "string", "maxLength": 1000 },
    "processed_by": { "type": "string" },
    "processed_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string" }
  },
  "required": ["user_id", "amount_cents", "currency", "status", "connected_account_id", "allocations", "idempotency_key"],
  "rls": {
    "read": { "$or": [{ "data.user_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": false, "update": false, "delete": false
  }
}