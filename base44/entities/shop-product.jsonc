{
  "name": "ShopProduct",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "product_type": {
      "type": "string",
      "enum": [
        "physical",
        "digital"
      ],
      "default": "digital"
    },
    "price_cents": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "GBP"
      ]
    },
    "stock_quantity": {
      "type": "integer",
      "minimum": 0
    },
    "image_url": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "sku": {
      "type": "string",
      "maxLength": 80
    }
  },
  "required": [
    "title",
    "description",
    "product_type",
    "price_cents",
    "currency",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}