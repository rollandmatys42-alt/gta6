{
  "name": "ShopProduct",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "product_type": {
      "type": "string",
      "enum": [
        "physical",
        "digital",
        "external"
      ],
      "default": "digital"
    },
    "price_cents": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "EUR",
        "GBP"
      ]
    },
    "stock_quantity": {
      "type": "integer",
      "minimum": 0
    },
    "image_url": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "sku": {
      "type": "string",
      "maxLength": 80
    },
    "category": {
      "type": "string",
      "enum": [
        "Apparel",
        "Accessories",
        "Collectibles",
        "Digital",
        "Creator Gear",
        "Other"
      ],
      "default": "Other"
    },
    "vendor_type": {
      "type": "string",
      "enum": [
        "vicehub",
        "licensed_partner",
        "official_external"
      ],
      "default": "vicehub"
    },
    "rights_status": {
      "type": "string",
      "enum": [
        "unverified",
        "original",
        "licensed",
        "official_external"
      ],
      "default": "unverified"
    },
    "external_url": {
      "type": "string",
      "format": "uri"
    },
    "shipping_required": {
      "type": "boolean",
      "default": false
    },
    "shipping_price_cents": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "size_options": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "color_options": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "rights_evidence_url": {
      "type": "string",
      "format": "uri"
    },
    "rights_note": {
      "type": "string",
      "maxLength": 1000
    },
    "digital_storage_key": {
      "type": "string",
      "maxLength": 500
    },
    "digital_storage_connection_id": {
      "type": "string",
      "maxLength": 128
    },
    "digital_file_name": {
      "type": "string",
      "maxLength": 180
    },
    "digital_content_type": {
      "type": "string",
      "maxLength": 100
    },
    "digital_file_size_bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "title",
    "description",
    "product_type",
    "price_cents",
    "currency",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
