{
  "name": "ReferralProfile",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "referral_code": { "type": "string", "maxLength": 12 },
    "status": { "type": "string", "enum": ["active", "suspended"], "default": "active" },
    "stripe_connect_account_id": { "type": "string" },
    "stripe_connect_status": { "type": "string", "enum": ["not_started", "onboarding", "under_review", "active"], "default": "not_started" },
    "payout_country": { "type": "string", "maxLength": 2 },
    "payouts_enabled": { "type": "boolean", "default": false }
  },
  "required": ["user_id", "referral_code", "status"],
  "rls": {
    "read": { "$or": [{ "data.user_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "create": false,
    "update": false,
    "delete": false
  }
}