{
  "name": "ReferralProfile",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "referral_code": { "type": "string", "maxLength": 12 },
    "status": { "type": "string", "enum": ["active", "suspended"], "default": "active" }
  },
  "required": ["user_id", "referral_code", "status"],
  "rls": {
    "read": { "$or": [{ "user_condition": { "id": "{{user.id}}" } }, { "user_condition": { "role": "admin" } }] },
    "create": false,
    "update": false,
    "delete": false
  }
}