{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "subject": {
      "type": "string",
      "maxLength": 180
    },
    "category": {
      "type": "string",
      "enum": [
        "account",
        "billing",
        "downloads",
        "copyright",
        "technical",
        "other"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 10000
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "waiting_customer",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "assigned_to": {
      "type": "string"
    },
    "internal_note": {
      "type": "string",
      "maxLength": 5000
    },
    "last_response_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "email",
    "subject",
    "category",
    "message",
    "status",
    "priority"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}