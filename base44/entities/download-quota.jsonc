{
  "name": "DownloadQuota",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "month_key": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "downloads_used": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "downloads_limit": {
      "type": "integer",
      "minimum": 0
    },
    "tier_code": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "pro",
        "premium"
      ]
    },
    "last_download_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "month_key",
    "downloads_used",
    "downloads_limit",
    "tier_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}