{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "endpoint": { "type": "string", "format": "uri", "maxLength": 2000 },
    "p256dh": { "type": "string", "maxLength": 300 },
    "auth": { "type": "string", "maxLength": 200 },
    "expiration_time": { "type": "integer" },
    "last_success_at": { "type": "string", "format": "date-time" },
    "last_error": { "type": "string", "maxLength": 300 }
  },
  "required": ["user_id", "endpoint", "p256dh", "auth"],
  "rls": {
    "read": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}