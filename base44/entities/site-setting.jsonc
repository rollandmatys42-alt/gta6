{
  "name": "SiteSetting",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "maxLength": 120
    },
    "setting_value": {
      "type": "string",
      "maxLength": 10000
    },
    "is_public": {
      "type": "boolean",
      "default": false
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "setting_key",
    "setting_value",
    "is_public"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}