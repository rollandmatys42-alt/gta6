{
  "name": "ShopReturnRequest",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "customer_email": {
      "type": "string",
      "format": "email"
    },
    "customer_name": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "approved",
        "rejected",
        "received",
        "refunded",
        "closed"
      ],
      "default": "requested"
    },
    "currency": {
      "type": "string",
      "enum": [
        "GBP",
        "EUR",
        "USD"
      ]
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_note": {
      "type": "string",
      "maxLength": 1000
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "order_id",
    "user_id",
    "customer_email",
    "reason",
    "items",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
