{
  "name": "AIContentDraft",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "TikTok",
        "Instagram",
        "YouTube",
        "X",
        "Facebook",
        "LinkedIn",
        "General"
      ]
    },
    "content_type": {
      "type": "string",
      "enum": [
        "Title",
        "Hook",
        "Caption",
        "Description",
        "Hashtags",
        "Script",
        "SEO",
        "GEO"
      ]
    },
    "topic": {
      "type": "string",
      "maxLength": 1000
    },
    "output": {
      "type": "string",
      "maxLength": 12000
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "saved",
        "archived"
      ],
      "default": "draft"
    },
    "provider": {
      "type": "string",
      "maxLength": 80
    }
  },
  "required": [
    "user_id",
    "platform",
    "content_type",
    "topic",
    "output",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": false,
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}